# Dependencies
node_modules/
**/node_modules/

# Secrets & local config (never commit)
.env
.env.*
**/.env
**/.env.*

# Runtime / local state (contains real OAuth tokens + usage counters)
.tokens.json
**/.tokens.json
.usage.json
**/.usage.json

# Build output
dist/
build/
**/dist/
**/build/

# Vite cache
.vite/
**/.vite/

# Logs
*.log
**/*.log

# OS / editor
.DS_Store
**/.DS_Store
.idea/
.vscode/

# iOS — the Xcode project is generated from ios/project.yml by XcodeGen,
# so the generated one is build output, not source.
ios/*.xcodeproj
ios/PulseOS/Info.plist
ios/*.xcworkspace
ios/build/
ios/DerivedData/

# The packaged desktop app: hundreds of megabytes of Electron and a DMG, all of
# it reproducible from `npm run desktop:build`.
desktop/out/
promo/out/

# The two long films are release assets, not committed video — see the `films`
# release. The silent loops beside them (tour-loop, day-loop) are committed,
# because those have to start the moment the page does.
docs/films/pulseos-tour.mp4
docs/films/pulseos-day.mp4
