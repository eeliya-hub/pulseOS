# Dependencies
node_modules/
**/node_modules/

# Secrets & local config (never commit)
.env
.env.*
**/.env
**/.env.*

# Runtime / local state (contains real OAuth tokens + usage counters)
.tokens.json
**/.tokens.json
.usage.json
**/.usage.json

# Build output
dist/
build/
**/dist/
**/build/

# Vite cache
.vite/
**/.vite/

# Logs
*.log
**/*.log

# OS / editor
.DS_Store
**/.DS_Store
.idea/
.vscode/

# iOS — the Xcode project is generated from ios/project.yml by XcodeGen,
# so the generated one is build output, not source.
ios/*.xcodeproj
ios/PulseOS/Info.plist
ios/*.xcworkspace
ios/build/
ios/DerivedData/
